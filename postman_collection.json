  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://backend-proyecto-si6n.onrender.com/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
